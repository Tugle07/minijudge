{
  "name": "minijudge-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web front-end cho MiniJudge: goi judge-cli (C) de cham bai",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "build:editor": "esbuild editor-src/entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=public/vendor/codemirror.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  }
}
