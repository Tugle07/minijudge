# Chép file này thành ~/minijudge.env trên máy chạy server (trong WSL), KHÔNG commit file thật lên GitHub.

# Mã lớp ban đầu (sau đó đổi được trong trang Admin › Cài đặt). Để trống = ai cũng đăng ký được.
REGISTER_CODE=

# Tài khoản luôn có quyền Admin (cách nhau dấu phẩy). Đăng ký tài khoản đúng tên này để vào /admin.html.
ADMIN_USERS=

# Tên miền riêng qua Cloudflare (tùy chọn). Để trống = dùng link *.trycloudflare.com tạm thời.
# TUNNEL_COMMAND=tunnel --no-autoupdate run
# TUNNEL_TOKEN=
